# 新竹市月子公會自動化系統 - 環境變數範本
# 請複製此檔案並命名為 .env，然後填入實際的金鑰與設定值

# LINE Messaging API 設定
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# LIFF 所屬的 LINE Login Channel ID（不是 LIFF ID，也不是 Messaging API Channel ID）
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here
LINE_LOGIN_SECRET=your_line_login_secret_here

# LINE LIFF 與系統對外網址設定
LINE_LIFF_ID=your_liff_id_here
# 月嫂身分驗證專用 LIFF；Endpoint URL 設為 https://你的網域/staff-verification-page
LINE_STAFF_VERIFICATION_LIFF_ID=your_staff_verification_liff_id_here
# 正式環境預設強制驗證；僅供本機測試時可明確設為 false
LIFF_REQUIRE_ID_TOKEN=false
INTERNAL_API_KEY=replace_with_a_long_random_internal_api_key
APP_ENV=development
# false 僅允許開發環境略過登入；production 永遠強制登入
ENABLE_ADMIN_AUTH=true
API_BASE_URL=http://127.0.0.1:8000
# 獨立 Monitor 從主機內部檢查 FastAPI 的位址
MONITOR_API_URL=http://127.0.0.1:8000/health
ADMIN_SESSION_MINUTES=30
# 以逗號分隔；正式環境請改為實際管理後台網址
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ENABLE_LINE_REVIEW_CONSOLE=true
# 人工審查等待超過此時數時，在管理中心顯示逾時提醒
LINE_REVIEW_STALE_HOURS=24
# true：三次自動重啟仍失敗時顯示 Windows 彈窗；false：改在開發終端詢問 y/n
ENABLE_SERVER_FAILURE_POPUP=false
ENABLE_REBIND_CONSOLE_REVIEW=false
BASE_URL=https://your-ngrok-domain.ngrok-free.app
# Rich Menu／LINE 圖片檔案儲存根目錄；正式環境建議指向 NAS 或受控磁碟
MEDIA_STORAGE_ROOT=.local_media
MEDIA_STORAGE_PROVIDER=local

# 資料庫連線配置 (供未來系統容器化或需要透過環境變數傳遞時使用)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_DATABASE=union_db
